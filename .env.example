# Lecture-to-Study-Pack Generator - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit actual secrets to version control

# ============================================================
# FLASK
# ============================================================
# Secret key for Flask sessions (change in production!)
SECRET_KEY=your-secret-key-here

# ============================================================
# LOCAL LLM (llama.cpp server) - DEFAULT PROVIDER
# ============================================================
# Base URL for local llama.cpp server (OpenAI-compatible /v1 endpoint)
# Example: http://localhost:8080/v1
LOCAL_LLM_BASE_URL=http://localhost:8080/v1

# API key for local server (usually not needed for local llama.cpp)
LOCAL_LLM_API_KEY=not-needed

# Model name (must match the model loaded in llama.cpp)
LOCAL_LLM_MODEL=qwen3-4b-q4_k_m

# Request timeout in seconds
LOCAL_LLM_TIMEOUT=300

# Maximum tokens to generate
LOCAL_LLM_MAX_TOKENS=4096

# ============================================================
# HOSTED OPENAI-COMPATIBLE PROVIDER (optional)
# ============================================================
# Base URL for hosted OpenAI-compatible API (e.g., Together.ai, Fireworks, etc.)
# Leave empty to disable
HOSTED_LLM_BASE_URL=

# API key for hosted provider
HOSTED_LLM_API_KEY=

# Model name to use (e.g., meta-llama/Llama-3-70b-chat-hf)
HOSTED_LLM_MODEL=

# Request timeout in seconds
HOSTED_LLM_TIMEOUT=120

# Maximum tokens to generate
HOSTED_LLM_MAX_TOKENS=4096

# ============================================================
# ANTHROPIC (optional)
# ============================================================
# Anthropic API key (get from https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Model to use
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Request timeout in seconds
ANTHROPIC_TIMEOUT=120

# Maximum tokens to generate
ANTHROPIC_MAX_TOKENS=4096

# ============================================================
# MODEL SELECTION
# ============================================================
# Default provider to use: local, openai_compatible, or anthropic
DEFAULT_MODEL_PROVIDER=local

# ============================================================
# NOTES
# ============================================================
# 1. For local development with llama.cpp:
#    - Start llama.cpp server: llama-server -m qwen3-4b-q4_k_m.gguf --host 0.0.0.0 --port 8080
#    - Set LOCAL_LLM_BASE_URL=http://localhost:8080/v1
#    - Set LOCAL_LLM_MODEL=qwen3-4b-q4_k_m (or your model name)
#
# 2. For hosted providers (Together.ai, Fireworks, etc.):
#    - Set HOSTED_LLM_BASE_URL, HOSTED_LLM_API_KEY, HOSTED_LLM_MODEL
#    - Set DEFAULT_MODEL_PROVIDER=openai_compatible
#
# 3. For Anthropic:
#    - Set ANTHROPIC_API_KEY
#    - Set DEFAULT_MODEL_PROVIDER=anthropic
#
# 4. SECRET_KEY must be changed in production!
#    Generate with: python -c "import secrets; print(secrets.token_hex(32))"
#
# ============================================================
# VIRTUAL ENVIRONMENT SETUP (Windows PowerShell)
# ============================================================
# The venv/ directory is local to your machine and is intentionally
# excluded from Git via .gitignore. Do NOT commit the venv/ directory.
#
# Create and activate virtual environment:
#   python -m venv venv
#   .\venv\Scripts\Activate.ps1
#
# Install dependencies:
#   pip install -r requirements.txt
#
# Deactivate when done:
#   deactivate